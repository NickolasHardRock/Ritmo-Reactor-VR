# Copie para .env e preencha. O .env NÃO vai para o Git (ver .gitignore).

# Porta do servidor local. Padrão 3000.
PORT=3000

# String de conexão do PostgreSQL.
# Se ficar VAZIA, a API roda com banco EM MEMÓRIA — útil para desenvolver
# sem instalar nada, mas os dados somem quando o processo reinicia.
#
# Onde conseguir uma grátis: neon.tech, supabase.com ou um Postgres local.
# Formato: postgres://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=

# Origens permitidas no CORS, separadas por vírgula.
# Em produção no Vercel front e API dividem o domínio e isso nem é usado.
CORS_ORIGENS=http://localhost:5173
